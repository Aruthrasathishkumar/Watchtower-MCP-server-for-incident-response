# WatchTower MCP Server Configuration
# Copy this file to .env and fill in real values.

# Database connection
WATCHTOWER_DB_HOST=localhost
WATCHTOWER_DB_PORT=5432
WATCHTOWER_DB_NAME=watchtower
WATCHTOWER_DB_USER=watchtower
WATCHTOWER_DB_PASSWORD=watchtower_dev_password

# Server behaviour
WATCHTOWER_LOG_LEVEL=INFO

# GitHub API
WATCHTOWER_GITHUB_TOKEN=ghp_your_token_here
WATCHTOWER_GITHUB_REPOS=owner/repo1,owner/repo2

# Approval Broker
WATCHTOWER_APPROVAL_SECRET=generate-with-python-secrets-token-urlsafe
WATCHTOWER_APPROVAL_TTL_SECONDS=300

# Slack collector
WATCHTOWER_SLACK_BOT_TOKEN=xoxb-your-bot-token
WATCHTOWER_SLACK_CHANNELS=C01234567,C89012345  # comma-separated channel IDs

# PagerDuty collector
WATCHTOWER_PAGERDUTY_API_TOKEN=your-pd-rest-api-token
WATCHTOWER_PAGERDUTY_SERVICES=  # optional comma-separated service IDs; empty = all